{
    "name": "bsmrg-gmbh/laravel-notification-channel-essendex",
    "description": "Essendex notification channel for Laravel",
    "authors": [
        {
            "name": "Dominic Martin",
            "email": "d0m4te@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/notifications": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/queue": "^12.0",
        "guzzlehttp/guzzle": "^7.2",
        "ext-json": "*"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "Bsmrg\\LaravelNotificationChannels\\Essendex\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bsmrg\\LaravelNotificationChannels\\Essendex\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "extra": {
        "laravel": {
            "providers": [
                "Bsmrg\\LaravelNotificationChannels\\Essendex\\EssendexServiceProvider"
            ]
        }
    }
}
